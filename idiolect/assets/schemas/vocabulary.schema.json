{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JeffWouters/Claude-Skill-Idiolect/schemas/v1/vocabulary.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "last_id": {
      "type": "integer",
      "minimum": 0,
      "description": "Highest id number ever used in this file; ids are never reused (spec §14.2)."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "kind",
          "private",
          "created"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "term",
              "spelling",
              "coinage",
              "keep"
            ]
          },
          "note": {
            "type": "string"
          },
          "private": {
            "type": "boolean",
            "description": "Private entries are never exported."
          },
          "overrides": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          },
          "created": {
            "$ref": "common.schema.json#/$defs/date"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "title": "profiles/<name>/vocabulary.yaml"
}
