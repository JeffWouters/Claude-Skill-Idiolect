{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JeffWouters/Claude-Skill-Idiolect/schemas/v2/manifest-entries.schema.json",
  "title": "snapshots/<timestamp>/manifest-entries.json — the manifest entries feeding one profile at snapshot time",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "taken",
    "texts"
  ],
  "properties": {
    "schema_version": {
      "const": 2,
      "description": "Version 2, with the manifest's version 2 entries. migrate.py upgrades version 1."
    },
    "profile": {
      "$ref": "https://github.com/JeffWouters/Claude-Skill-Idiolect/schemas/v1/common.schema.json#/$defs/profileName"
    },
    "taken": {
      "$ref": "https://github.com/JeffWouters/Claude-Skill-Idiolect/schemas/v1/common.schema.json#/$defs/dateTime"
    },
    "texts": {
      "type": "object",
      "propertyNames": {
        "$ref": "https://github.com/JeffWouters/Claude-Skill-Idiolect/schemas/v1/common.schema.json#/$defs/textKey"
      },
      "additionalProperties": {
        "$ref": "https://github.com/JeffWouters/Claude-Skill-Idiolect/schemas/v2/manifest.schema.json#/$defs/entry"
      }
    }
  },
  "additionalProperties": false
}
