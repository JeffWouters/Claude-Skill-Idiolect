{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JeffWouters/Claude-Skill-Idiolect/schemas/v2/rulings.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 2,
      "description": "Version 2: rulings may carry a test (spec §27). migrate.py upgrades version 1."
    },
    "last_id": {
      "type": "integer",
      "minimum": 0,
      "description": "Highest id number ever used in this file; ids are never reused (spec §14.2)."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "origin",
          "created",
          "personal_data"
        ],
        "properties": {
          "id": {
            "$ref": "https://github.com/JeffWouters/Claude-Skill-Idiolect/schemas/v1/common.schema.json#/$defs/id"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "oneOf": [
              {
                "$ref": "https://github.com/JeffWouters/Claude-Skill-Idiolect/schemas/v1/common.schema.json#/$defs/slotKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "null = applies to every slot."
          },
          "overrides": {
            "oneOf": [
              {
                "$ref": "https://github.com/JeffWouters/Claude-Skill-Idiolect/schemas/v1/common.schema.json#/$defs/id"
              },
              {
                "type": "null"
              }
            ],
            "description": "Id of a parent profile's ruling this replaces."
          },
          "origin": {
            "enum": [
              "stated",
              "promoted",
              "starter"
            ]
          },
          "promoted_from": {
            "type": "string",
            "pattern": "^(l|d)-[0-9]{3,6}$",
            "description": "The observed or edit lesson this ruling was promoted from."
          },
          "created": {
            "$ref": "https://github.com/JeffWouters/Claude-Skill-Idiolect/schemas/v1/common.schema.json#/$defs/date"
          },
          "personal_data": {
            "const": "none"
          },
          "test": {
            "description": "What check looks for (spec §27). One form per ruling.",
            "oneOf": [
              {
                "type": "object",
                "title": "characters",
                "required": [
                  "chars"
                ],
                "additionalProperties": false,
                "properties": {
                  "chars": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1
                    }
                  }
                }
              },
              {
                "type": "object",
                "title": "whole words",
                "required": [
                  "words"
                ],
                "additionalProperties": false,
                "properties": {
                  "words": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^\\S+$"
                    }
                  }
                }
              },
              {
                "type": "object",
                "title": "phrases",
                "required": [
                  "phrases"
                ],
                "additionalProperties": false,
                "properties": {
                  "phrases": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 2
                    }
                  }
                }
              },
              {
                "type": "object",
                "title": "pattern",
                "required": [
                  "pattern"
                ],
                "additionalProperties": false,
                "properties": {
                  "pattern": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Python regular expression, case insensitive, per line."
                  }
                }
              }
            ]
          },
          "lang": {
            "oneOf": [
              {
                "$ref": "https://github.com/JeffWouters/Claude-Skill-Idiolect/schemas/v1/common.schema.json#/$defs/langValue"
              },
              {
                "type": "null"
              }
            ],
            "description": "The ruling applies only to slots in this language; null: every slot."
          },
          "unless_writer_uses": {
            "type": "boolean",
            "description": "When the writer's own texts of the slot show the test, a draft is flagged only above twice their rate."
          },
          "starter": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false,
            "description": "Loaded from the starter set: which rule, at which set version.",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^s-[0-9]{3}$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+$"
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$",
                "description": "Of the text, test and unless_writer_uses as loaded; a ruling that no longer matches it was edited by the writer."
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "declined": {
      "type": "array",
      "description": "Starter rules the writer rejected; not proposed again at the same set version.",
      "items": {
        "type": "object",
        "required": [
          "starter",
          "version",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "starter": {
            "type": "string",
            "pattern": "^s-[0-9]{3}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$",
            "description": "Of the rule as declined; offered again only when the set changes it."
          },
          "date": {
            "$ref": "https://github.com/JeffWouters/Claude-Skill-Idiolect/schemas/v1/common.schema.json#/$defs/date"
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "title": "profiles/<name>/rulings.yaml"
}
